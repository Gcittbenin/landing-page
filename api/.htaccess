# Vercel only. This directory is NOT deployed to LWS — see the `exclude:` list
# in .github/workflows/deploy.yml, and the reason it is excluded.
#
# In short: `api/` is the one directory in the project whose name collides with
# URLs the application really serves — /api/lead and /api/event. A directory of
# that name sitting on disk lets Apache resolve those URLs to the filesystem,
# and these rules would then answer 403 to the lead form and to every analytics
# beacon, before Passenger is ever asked. On LWS the directory must simply not
# exist; server.js calls lib/handler.js directly and never imports api/lead.js.
#
# The rules below remain for any host that does serve this directory from disk.
#
# Do NOT create an .htaccess in the application root: cPanel generates one
# there with the Passenger directives, and overwriting it breaks the app.

# Apache 2.4
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>

# Apache 2.2
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
