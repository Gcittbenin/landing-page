# Server-side source: never serve it over HTTP.
#
# The primary guard is server.js, which serves only an allow-list of public
# paths (assets/, uploads/, vendor/ and a handful of root files) and answers
# 404 for everything else. These rules are a second layer, for the case where
# Passenger is stopped and Apache serves this directory directly — the
# application root sits inside public_html, so that fallback is reachable.
#
# Do NOT create an .htaccess in the application root: cPanel generates one
# there with the Passenger directives, and overwriting it breaks the app.

# Apache 2.4
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>

# Apache 2.2
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
