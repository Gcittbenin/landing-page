# ─────────────────────────────────────────────────────────────────────────────
# GCITT landing page — configuration
#
# Copy to `.env` for local work, or paste into the hosting provider's
# environment-variable settings for production.
#
# .env is git-ignored. None of these values are ever exposed to the browser:
# the frontend only talks to /api/lead, which never echoes configuration back.
# ─────────────────────────────────────────────────────────────────────────────

# ── WhatsApp Business Cloud API (Meta) ───────────────────────────────────────
# From Meta for Developers → your app → WhatsApp → API Setup.
# Use a permanent System User token, not the 24h temporary one.
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_BUSINESS_ACCOUNT_ID=

# Graph API version. Pinned deliberately — bump it consciously.
META_API_VERSION=v21.0

# Where the alert is sent: the GCITT sales line, country code first, digits
# only, no '+' and no spaces. Defaults to the number in the page footer.
GCITT_SALES_WHATSAPP=2290167212128

# Name of the message template approved by Meta. Leave empty and the alert is
# sent as free-form text, which Meta only delivers inside a 24h window — fine
# for testing, not for production. See docs/WHATSAPP.md.
META_WHATSAPP_TEMPLATE_NAME=
META_WHATSAPP_TEMPLATE_LANG=fr

# ── Email ────────────────────────────────────────────────────────────────────
EMAIL_API_KEY=
# One or more recipients, comma-separated.
EMAIL_DESTINATION=commercial@gcitt.com
# resend | sendgrid
EMAIL_PROVIDER=resend
# Must be a domain verified with the provider.
EMAIL_FROM=GCITT Landing <notifications@gcitt.com>
EMAIL_SUBJECT=Nouveau prospect - Demande villa GCITT

# Acknowledgement sent to the prospect. On unless set to false.
EMAIL_CONFIRMATION_ENABLED=true
EMAIL_CONFIRMATION_SUBJECT=Votre demande a bien été reçue — GCITT BENIN
# Where a prospect's reply lands. Defaults to the first EMAIL_DESTINATION.
EMAIL_REPLY_TO=commercial@gcitt.com

# ── Coordonnées affichées au prospect ────────────────────────────────────────
# Shown in the confirmation email. Override here rather than editing code.
GCITT_CONTACT_WHATSAPP=+229 01 67 21 21 28
GCITT_CONTACT_PHONE=+229 01 64 61 61 56
GCITT_CONTACT_EMAIL=contact@gcitt.com
GCITT_WEBSITE=www.gcitt.com
GCITT_ADDRESS=C/875 Aïdjèdo 1, Immeuble Basile Kossou, 03 BP 3803, Cotonou, Bénin
SITE_URL=https://nos-villas.gcitt.com

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production

# PORT is supplied by the host (LWS, Vercel, …) — do NOT set it in production.
# server.js falls back to 3000 only when it is absent, for local development.
# PORT=3000

# Trust X-Forwarded-For. Must stay true behind a reverse proxy (LWS, nginx,
# Apache), otherwise every visitor shares the proxy's IP and therefore a single
# rate-limit bucket. Set to false only if Node is exposed directly.
TRUST_PROXY=true

# ── Security ─────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to POST the form. Leave empty for
# same-origin only, which is correct when the page and API share a domain.
# e.g. ALLOWED_ORIGINS=https://nos-villas.gcitt.com
ALLOWED_ORIGINS=

# Sliding window per IP.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000

# Submissions completed faster than this are treated as bots (milliseconds).
MIN_FILL_MS=3000

# ── Base des prospects (dashboard /admin) ────────────────────────────────────
# Chaque prospect validé est enregistré localement avant l'envoi des
# notifications : c'est la seule copie qui survit à une panne WhatsApp ou
# email. Mettre à `false` uniquement sur un hébergement en lecture seule.
LEAD_STORE=true

# Répertoire des fichiers leads.jsonl / events.jsonl. Vide = <projet>/data.
# Doit être accessible en écriture et hors de la racine web (le serveur ne sert
# que les fichiers de sa liste blanche, data/ n'en fait pas partie).
# Ce répertoire est exclu du déploiement : un envoi FTP ne l'écrase jamais.
DATA_DIR=

# ── Espace d'administration (/admin) ─────────────────────────────────────────
# TANT QU'AUCUN MOT DE PASSE N'EST DÉFINI, /admin RÉPOND 404 : le tableau de
# bord n'existe pas. C'est volontaire — un dashboard déployé par accident est
# pire que pas de dashboard du tout.
#
# Mot de passe en clair : pratique, haché au démarrage, jamais comparé en clair.
ADMIN_PASSWORD=

# Alternative : le haché scrypt (« sel:empreinte »), pour ne pas mettre le mot
# de passe en clair dans le panneau de l'hébergeur. Générer avec :
#   node -e "import('./lib/auth.js').then(m=>console.log(m.hashPassword('votre-mot-de-passe')))"
ADMIN_PASSWORD_HASH=

# Identifiant de connexion. « admin » par défaut.
ADMIN_USERNAME=

# Clé de signature des cookies de session. Sans elle, une clé aléatoire est
# tirée à chaque démarrage : tout le monde est déconnecté à chaque
# redémarrage. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Le cookie de session est marqué Secure (HTTPS uniquement). À passer à false
# seulement pour un développement local en http://.
ADMIN_COOKIE_SECURE=

# Où répond la console. « /admin » par défaut.
#
# À CHANGER SI L'HÉBERGEUR RENVOIE UNE ERREUR 500 SUR /admin : ce chemin est
# réservé par un alias Apache chez beaucoup d'hébergements mutualisés, et la
# requête est alors interceptée avant d'atteindre l'application. Voir la
# section « Diagnostiquer une erreur 500 » de DEPLOIEMENT_LWS.md.
#
# Lettres, chiffres et . _ ~ - uniquement ; toute autre valeur est refusée et
# /admin est conservé. Déplacer la console retire aussi une cible permanente
# d'attaque par force brute.
#   ADMIN_PATH=/pilotage
ADMIN_PATH=

# ── CRM (future) ─────────────────────────────────────────────────────────────
# When set, each lead is POSTed as JSON here after the notifications fire.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=

# ── Marketing tracking ───────────────────────────────────────────────────────
# These IDs are public by nature — they ship to the browser. Set them in
# assets/tracking-config.js, not here; listed only so the full surface is in
# one place.
#   GA4  : G-XXXXXXXXXX
#   GTM  : GTM-XXXXXXX
#   Meta : 000000000000000
